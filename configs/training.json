{
  "optimizer": "adamw",
  "learning_rate": 0.0003,
  "weight_decay": 0.01,
  "beta1": 0.9,
  "beta2": 0.999,
  "eps": 1e-8,
  "grad_clip_norm": 1.0,
  "lr_scheduler": "cosine",
  "warmup_steps": 200,
  "total_steps": 5000,
  "batch_size": 16,
  "grad_accum_steps": 1,
  "diffusion_steps": 1000,
  "noise_schedule": "cosine",
  "cfg_uncond_prob": 0.1,
  "checkpoint_every_steps": 500,
  "log_every_steps": 20,
  "val_every_steps": 100,
  "seed": 42
}
